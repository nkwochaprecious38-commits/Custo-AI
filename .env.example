# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this in the browser. Used for store integrations, tracking ingestion and team invite emails.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public URL of this app, used in email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: enables AI answers in the Commerce Assistant and AI query understanding in search
ANTHROPIC_API_KEY=
